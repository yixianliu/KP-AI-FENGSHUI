; ================================================================
; AI风水命理分析系统 - 配置文件范本
; ================================================================
; 复制此文件为 config.ini 并根据实际环境修改配置
; 配置项说明：
;   - 所有配置项均使用 key = value 格式
;   - 分号开头的行为注释行
;   - 字符串值不需要引号
;
; 存储说明：
;   本系统自 v5.x 起已统一数据存储为【本地嵌入式 SQLite 数据库】，
;   无需单独架设数据库服务器。数据库文件默认位于项目根目录的
;   data/fengshui.db（打包后位于程序目录的 data/fengshui.db）。
;   首次运行时自动建库并导入基础命理数据，无需任何额外配置。
; ================================================================

; ================================================================
; AI模型配置（唯一需要填写的配置段）
; ================================================================

[agnes]
; AI模型API地址
; 默认值：https://api.agnes-ai.cn/v1/chat/completions（Agnes AI 平台）
api_url = https://api.agnes-ai.cn/v1/chat/completions

; API密钥
; 格式：Bearer <your_access_token>
; 获取方式：登录 Agnes AI 平台控制台获取 API Key
; 注意：请妥善保管此密钥，不要泄露给他人
api_key = Bearer your_api_key_here

; AI模型名称
; 推荐：agnes-2.5-flash（响应快）或 agnes-2.0-flash（兼容模式）
; 默认值：agnes-2.5-flash
model = agnes-2.5-flash

; API请求重试次数
; 默认值：2
max_retries = 2

; 请求重试间隔（秒）
; 默认值：2
retry_delay = 2

; API请求超时时间（秒）
; 默认值：60
timeout = 60

; ================================================================
; 可选配置项（如需启用请取消注释并修改）
; ================================================================

; [app]
; ; 应用调试模式
; ; 默认值：false（生产模式）
; debug = false
;
; ; 日志级别
; ; 默认值：INFO
; ; 可选值：DEBUG, INFO, WARNING, ERROR
; log_level = INFO

; [analysis]
; ; AI分析最大字符数限制
; ; 默认值：4096
; max_tokens = 4096
;
; ; 分析温度参数（0-1）
; ; 默认值：0.3（较低温度，结果更稳定）
; temperature = 0.3
