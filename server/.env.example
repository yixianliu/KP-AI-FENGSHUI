# ================================================================
# AI 中转服务环境变量范本
# ================================================================
# 用法：复制为 .env 并填入真实值。
#
# 安全红线：
#   1. .env 绝不可提交进 git（已在 .gitignore 中屏蔽）
#   2. .env 绝不可打包进客户端 exe
#   3. 生产环境建议直接用平台的密钥管理（如 systemd 的 EnvironmentFile、
#      Docker secrets、云厂商的配置中心），而不是落地 .env 文件
# ================================================================

# ---------- 上游 AI（唯一持有真实密钥的位置） ----------
AGNES_API_URL=https://api.agnes-ai.cn/v1/chat/completions
# 注意格式：需要带 "Bearer " 前缀，与上游要求一致
AGNES_API_KEY=Bearer sk-替换为你在Agnes控制台新建的密钥
AGNES_MODEL=agnes-2.5-flash

# ---------- 客户端准入密钥 ----------
# 逗号分隔，可配置多个以便灰度轮换（新版客户端用新 key，旧版仍可用旧 key）
# 生成方式： python -c "import secrets;print(secrets.token_urlsafe(24))"
# 提醒：此 key 随 exe 分发，必然会泄露，它只是门槛不是秘密。
#      真正的控制手段是设备令牌吊销与配额。
APP_KEYS=替换为随机生成的客户端准入密钥

# ---------- 管理员令牌 ----------
# 用于 /admin/* 接口。绝不下发客户端。
# 生成方式： python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=替换为随机生成的管理员令牌

# ---------- 存储 ----------
RELAY_DB_PATH=data/relay.db

# ---------- 配额（保护你的账单） ----------
# 单设备每日调用上限
DEVICE_DAILY_QUOTA=100
# 全服务每日调用上限，超出后直接拒绝，防止被刷爆
GLOBAL_DAILY_QUOTA=20000
# 单 IP 每日注册上限，防批量刷设备
REGISTER_IP_DAILY_LIMIT=20

# ---------- 上游请求约束 ----------
UPSTREAM_TIMEOUT=120
MAX_MESSAGES=12
MAX_CHARS_PER_REQUEST=24000
MAX_TOKENS_CAP=2048
