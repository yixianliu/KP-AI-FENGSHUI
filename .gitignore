# ================================================================
# KP-AI-FENGSHUI 版本控制忽略清单
# 分组原则：IDE 配置 / Python 缓存 / 构建产物 / 运行期数据 / 机密文件
# ================================================================

# ---- IDE 与编辑器 ----
/.idea/
/.vscode/
/.trae/
/.workbuddy/

# ---- Python 缓存与虚拟环境 ----
__pycache__/
*.py[cod]
*.egg-info/
/venv/
/test_env/
/.pytest_cache/

# ---- 构建产物（PyInstaller）----
/dist/
/build/
/dist_prev/

# ---- 运行期生成数据（数据库为二进制种子库，按需单独提交）----
/logs/
*.log
/data/
/.uploads/

# ---- 前端遗留（本项目已不使用）----
/node_modules/
/package-lock.json

# ---- 误建的 Windows 保留名文件（需用 UNC 前缀手动清理）----
/nul

# ================================================================
# 机密文件 —— 任何情况下都不得入库
# ================================================================
# 环境变量文件
.env
*.env

# 构建期生成的混淆内置配置（含 AI 密钥混淆体）
core/_embedded_config.py

# 本机 AI 配置（含设备指纹混淆后的 API 密钥）
ai_config.json
config.ini

# 打包前 purge 生成的凭据备份（含明文密钥，绝不可入库）
/.ai_purge_backup/

# 客户端本机设备标识
device.json
**/device.json
tests
