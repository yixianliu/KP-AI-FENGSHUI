; ================================================================
; 风水排盘专业工具 —— 客户端配置范本
; ================================================================
; 复制此文件为 config.ini 并按实际环境修改。
;
; 【重要 · 安全说明】
; 本文件会随 exe 分发给所有公众用户，因此不得包含任何机密信息。
; 上游 AI 密钥（sk-...）已迁移到中转服务的环境变量中，
; 客户端不再持有、不再传输任何上游密钥。
;
; 原因：客户端运行在用户完全掌控的机器上，任何随程序分发的密钥都可被
;      抓包、内存扫描、解包反编译取走，代码混淆对前两者完全无效。
;      详见 server/README.md 与 docs/SECURITY.md。
;
; 存储说明：
;   业务数据统一使用本地 SQLite（data/fengshui.db），首次运行自动建库。
; ================================================================

[relay]
; ----------------------------------------------------------------
; 中转服务地址
; ----------------------------------------------------------------
; 必须是 HTTPS。使用明文 HTTP 会导致设备令牌在链路上被窃听。
base_url = https://relay.example.com

; ----------------------------------------------------------------
; 客户端准入密钥
; ----------------------------------------------------------------
; 需与服务端 .env 中的 APP_KEYS 之一保持一致。
;
; 注意：此密钥随 exe 分发，必然可被用户读取，它不是秘密，只是一道门槛，
;      用于挡住随手刷接口的行为。真正的访问控制依靠：
;        1. 设备令牌（一机一份，服务端可单独吊销）
;        2. 服务端逐设备 / 全局配额
;      即使本密钥泄露，上游 AI 密钥仍然安全。
;
; 生成方式：python -c "import secrets;print(secrets.token_urlsafe(24))"
app_key = 替换为与服务端一致的准入密钥

; ----------------------------------------------------------------
; 模型名
; ----------------------------------------------------------------
; 仅用于分析记录的展示字段；实际调用哪个模型由服务端强制指定，
; 客户端无权选择，以防被诱导调用高价模型。
model = agnes-2.5-flash

; ----------------------------------------------------------------
; 请求参数
; ----------------------------------------------------------------
; 请求重试次数（仅对 5xx 等瞬时错误重试；配额用尽不重试）
max_retries = 2

; 重试间隔（秒），实际采用指数退避
retry_delay = 5

; 请求超时（秒）
timeout = 120
